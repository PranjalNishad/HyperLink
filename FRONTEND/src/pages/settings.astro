---
import Layout from "@/layouts/Layout.astro";
import Sidebar from "@/components/layout/Sidebar.astro";
import Button from "@/components/common/Button.astro";
---

<Layout
  title="Settings — HyperLink"
  description="Manage your HyperLink account and session."
>
  <div class="flex min-h-screen flex-col lg:flex-row">
    <Sidebar active="settings" />

    <div class="min-w-0 flex-1">
      <main class="mx-auto w-full max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
        <div>
          <h1 class="m-0 text-2xl font-semibold tracking-tight text-[var(--color-text-primary)] sm:text-3xl">
            Settings
          </h1>
          <p class="mt-1 m-0 text-sm leading-relaxed text-[var(--color-text-muted)]">
            Manage your account, security, and session.
          </p>
        </div>

        <!-- Account -->
        <section class="mt-8 premium-card p-6">
          <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[var(--gradient-primary-soft)] text-[var(--color-primary)]">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="4" />
                <path d="M5 20c1.5-3 4-4.5 7-4.5s5.5 1.5 7 4.5" />
              </svg>
            </div>
            <div>
              <h2 class="m-0 text-base font-semibold tracking-tight text-[var(--color-text-primary)]">Account</h2>
              <p class="m-0 text-sm text-[var(--color-text-muted)]">Profile editing is not available yet.</p>
            </div>
          </div>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Name</span>
              <p class="mt-1 m-0 text-sm text-[var(--color-text-secondary)]">Not available</p>
            </div>
            <div>
              <span class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Email</span>
              <p class="mt-1 m-0 text-sm text-[var(--color-text-secondary)]">Not available</p>
            </div>
          </div>
        </section>

        <!-- Security -->
        <section class="mt-6 premium-card p-6">
          <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[var(--gradient-primary-soft)] text-[var(--color-secondary)]">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
            </div>
            <div>
              <h2 class="m-0 text-base font-semibold tracking-tight text-[var(--color-text-primary)]">Security</h2>
              <p class="m-0 text-sm text-[var(--color-text-muted)]">Password reset is not available yet.</p>
            </div>
          </div>
          <div class="mt-5">
            <Button variant="secondary" size="sm" disabled>Change password</Button>
          </div>
        </section>

        <!-- Session -->
        <section class="mt-6 premium-card p-6">
          <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[var(--gradient-primary-soft)] text-[var(--color-danger)]">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <path d="M16 17l5-5-5-5" />
                <path d="M21 12H9" />
              </svg>
            </div>
            <div>
              <h2 class="m-0 text-base font-semibold tracking-tight text-[var(--color-text-primary)]">Session</h2>
              <p class="m-0 text-sm text-[var(--color-text-muted)]">End your current session on this device.</p>
            </div>
          </div>
          <div class="mt-5">
            <Button id="settings-logout" variant="danger" size="sm">Log out</Button>
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>

<script>
  import { logout } from "@/api/auth.api";

  document.getElementById("settings-logout")?.addEventListener("click", async () => {
    try {
      await logout();
      window.location.href = "/";
    } catch {
      // ignore
    }
  });
</script>
