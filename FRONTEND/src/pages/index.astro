---
import Layout from "@/layouts/Layout.astro";
import NavBar from "@/components/layout/NavBar.astro";
import Footer from "@/components/layout/Footer.astro";
import Hero from "@/components/landing/Hero.astro";
import UrlShortener from "@/components/landing/UrlShortener.astro";
import Features from "@/components/landing/Features.astro";
import Architecture from "@/components/landing/Architecture.astro";
import Button from "@/components/common/Button.astro";
---

<Layout
  title="HyperLink — Short Links. Big Possibilities."
  description="Create short, powerful links with HyperLink."
  stars={22}
>
  <div class="relative flex min-h-screen flex-col overflow-x-clip">
    <NavBar />

    <main class="relative flex-1">
      <Hero>
        <UrlShortener />
      </Hero>

      <Features />
      <Architecture />

      <!-- Final CTA -->
      <section class="relative overflow-hidden py-20 md:py-28">
        <div class="container-page relative px-4 text-center">
          <div class="mx-auto max-w-2xl rounded-[2rem] border border-[var(--glass-border)] bg-[var(--glass-panel)] px-6 py-12 shadow-[var(--shadow-lg)] backdrop-blur-2xl">
            <h2 class="m-0 text-2xl font-semibold tracking-tight text-[var(--color-text-primary)] sm:text-3xl md:text-4xl">
              Ready to shorten the way you share?
            </h2>
            <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-[var(--color-text-muted)]">
              Create your first short link with HyperLink.
            </p>

            <div class="mt-8 flex justify-center">
              <Button variant="primary" size="lg">
                <a href="/signup" data-auth-href class="text-inherit no-underline">Get Started</a>
              </Button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
