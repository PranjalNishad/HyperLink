---
interface Props {
  /** Density of decorative stars. */
  stars?: number;
}

const { stars = 18 } = Astro.props;

// Deterministic pseudo-random star field (no runtime cost, no hydration).
const starPositions = Array.from({ length: stars }, (_, i) => {
  const x = ((i * 137.508) % 100).toFixed(2);
  const y = ((i * 61.803 + 17) % 100).toFixed(2);
  const size = i % 5 === 0 ? "cosmic-star cosmic-star-lg" : "cosmic-star";
  const delay = ((i * 0.37) % 4).toFixed(2);
  return { x, y, size, delay, dim: i % 3 === 0 };
});
---

<div class="cosmic-bg" aria-hidden="true">
  <div class="cosmic-base"></div>

  <div class="cosmic-glow cosmic-glow-1"></div>
  <div class="cosmic-glow cosmic-glow-2"></div>
  <div class="cosmic-glow cosmic-glow-3"></div>

  <!-- Orbital light trails -->
  <svg
    class="cosmic-trails"
    viewBox="0 0 1440 900"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="trailGradA" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--cosmic-trail-a)" stop-opacity="0" />
        <stop offset="35%" stop-color="var(--cosmic-trail-b)" stop-opacity="0.9" />
        <stop offset="100%" stop-color="var(--cosmic-trail-c)" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="trailGradB" x1="0%" y1="0%" x2="100%" y2="60%">
        <stop offset="0%" stop-color="var(--cosmic-trail-c)" stop-opacity="0" />
        <stop offset="45%" stop-color="var(--cosmic-trail-a)" stop-opacity="0.85" />
        <stop offset="100%" stop-color="var(--cosmic-trail-b)" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="trailGradC" x1="0%" y1="50%" x2="100%" y2="50%">
        <stop offset="0%" stop-color="var(--cosmic-trail-b)" stop-opacity="0" />
        <stop offset="50%" stop-color="var(--cosmic-trail-c)" stop-opacity="0.7" />
        <stop offset="100%" stop-color="var(--cosmic-trail-a)" stop-opacity="0" />
      </linearGradient>
      <filter id="trailBlur" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="6" />
      </filter>
    </defs>

    <!-- Blurred glow duplicates -->
    <g filter="url(#trailBlur)" opacity="0.7">
      <path d="M-120 520 C 260 300, 620 300, 940 180 S 1360 40, 1600 90" stroke="url(#trailGradA)" stroke-width="10" />
      <path d="M-80 780 C 320 700, 700 760, 1040 620 S 1420 420, 1620 470" stroke="url(#trailGradB)" stroke-width="10" />
      <path d="M200 980 C 520 820, 900 880, 1240 720 S 1500 560, 1620 600" stroke="url(#trailGradC)" stroke-width="8" />
    </g>

    <!-- Crisp trails -->
    <path d="M-120 520 C 260 300, 620 300, 940 180 S 1360 40, 1600 90" stroke="url(#trailGradA)" stroke-width="1.4" />
    <path d="M-80 780 C 320 700, 700 760, 1040 620 S 1420 420, 1620 470" stroke="url(#trailGradB)" stroke-width="1.2" />
    <path d="M200 980 C 520 820, 900 880, 1240 720 S 1500 560, 1620 600" stroke="url(#trailGradC)" stroke-width="1" />
    <path d="M-100 220 C 300 140, 700 260, 1080 120 S 1440 -20, 1620 30" stroke="url(#trailGradC)" stroke-width="0.9" opacity="0.6" />

    <!-- Faint orbital rings -->
    <ellipse cx="1080" cy="200" rx="520" ry="300" stroke="url(#trailGradA)" stroke-width="0.6" opacity="0.35" />
    <ellipse cx="260" cy="760" rx="560" ry="320" stroke="url(#trailGradB)" stroke-width="0.6" opacity="0.3" />
  </svg>

  <!-- Planets -->
  <div class="cosmic-planet cosmic-planet-tr"></div>
  <div class="cosmic-planet cosmic-planet-bl"></div>

  <!-- Stars -->
  <div class="cosmic-stars">
    {
      starPositions.map((star) => (
        <span
          class={star.size}
          style={`left:${star.x}%;top:${star.y}%;opacity:${star.dim ? 0.5 : 0.9};animation-delay:${star.delay}s`}
        />
      ))
    }
  </div>
</div>
