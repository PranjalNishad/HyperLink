---
import Button from "@/components/common/Button.astro";
---

<div
  class="relative mx-auto flex min-h-[340px] w-full max-w-[600px] flex-col justify-center rounded-[28px] border border-[var(--glass-border)] bg-[var(--glass-panel)] p-7 shadow-[var(--shadow-lg)] backdrop-blur-2xl sm:p-9"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="m-0 text-2xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-[1.75rem]">
        Shorten Your URL
      </h2>
      <p class="mt-2.5 m-0 text-base leading-relaxed text-[var(--color-text-muted)] sm:text-[1.0625rem]">
        Paste a long URL and turn it into a clean, shareable link.
      </p>
    </div>
  </div>

  <form id="shorten-form" class="mt-7 flex flex-col gap-3" novalidate>
    <div class="relative">
      <div class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-[var(--color-text-muted)]">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.72" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.72-1.72" />
        </svg>
      </div>
      <input
        type="url"
        name="url"
        id="shorten-url"
        placeholder="https://example.com/your-long-url"
        aria-label="Long URL to shorten"
        class="input-base h-[3.625rem] w-full rounded-2xl pl-11 pr-4 text-base text-[var(--color-text-primary)] placeholder:text-[var(--color-text-subtle)]"
        required
      />
    </div>

    <Button type="submit" variant="primary" size="xl" class="w-full" id="shorten-submit">
      Shorten
    </Button>
  </form>

  <p id="shorten-error" class="mt-4 hidden text-sm text-[var(--color-danger)]" role="alert"></p>

  <!-- Success state -->
  <div
    id="shorten-result"
    class="mt-7 hidden rounded-2xl border border-[rgba(74,222,128,0.35)] bg-[rgba(74,222,128,0.08)] p-4"
  >
    <div class="flex items-center gap-2 text-[var(--color-success)]">
      <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="10" cy="10" r="8" />
        <path d="m6.5 10 2.2 2.2 4.8-4.8" />
      </svg>
      <span class="text-sm font-medium">Link shortened successfully!</span>
    </div>

    <div class="mt-3 flex items-center gap-3">
      <a
        id="shorten-result-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="min-w-0 flex-1 truncate text-sm font-semibold text-[var(--color-text-primary)] transition-colors hover:text-[var(--color-primary)]"
      ></a>
      <button
        type="button"
        id="shorten-copy"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-[var(--glass-border)] bg-[var(--glass-background)] text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--glass-background-hover)] hover:text-[var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]"
        aria-label="Copy short URL"
        title="Copy short URL"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="6" y="6" width="7" height="7" rx="1.5" />
          <path d="M10 6V4.5A1.5 1.5 0 0 0 8.5 3h-5A1.5 1.5 0 0 0 2 4.5v5A1.5 1.5 0 0 0 3.5 11H6" />
        </svg>
      </button>
    </div>
  </div>

  <ul class="mt-7 flex list-none flex-wrap items-center justify-center gap-x-6 gap-y-2.5 p-0 sm:justify-start">
    <li class="flex items-center gap-2 text-sm font-medium text-[var(--color-text-muted)]">
      <svg viewBox="0 0 16 16" class="h-4 w-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 1.5 10 4l3 .5-2 2.2.5 3L8 8.4l-3.5 1.3.5-3-2-2.2L6 4z" />
      </svg>
      Fast
    </li>
    <li class="flex items-center gap-2 text-sm font-medium text-[var(--color-text-muted)]">
      <svg viewBox="0 0 16 16" class="h-4 w-4 text-[var(--color-secondary)]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 2.5 13 5v3.2c0 2.9-2 5-5 6.3-3-1.3-5-3.4-5-6.3V5z" />
        <path d="m6.2 8 1.2 1.2L10 6.7" />
      </svg>
      Secure
    </li>
    <li class="flex items-center gap-2 text-sm font-medium text-[var(--color-text-muted)]">
      <svg viewBox="0 0 16 16" class="h-4 w-4 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 13V8M8 13V3M13 13v-3" />
      </svg>
      Analytics
    </li>
  </ul>

  <script>
    import { createShortUrl } from "@/api/shortUrl.api";

    const form = document.getElementById("shorten-form") as HTMLFormElement | null;
    const urlInput = document.getElementById("shorten-url") as HTMLInputElement | null;
    const submitButton = document.getElementById("shorten-submit") as HTMLButtonElement | null;
    const errorEl = document.getElementById("shorten-error") as HTMLParagraphElement | null;
    const resultEl = document.getElementById("shorten-result") as HTMLDivElement | null;
    const resultLink = document.getElementById("shorten-result-link") as HTMLAnchorElement | null;
    const copyButton = document.getElementById("shorten-copy") as HTMLButtonElement | null;

    let shortUrl = "";

    function setError(message: string) {
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
      }
    }

    function clearError() {
      errorEl?.classList.add("hidden");
    }

    function setLoading(isLoading: boolean) {
      if (submitButton) submitButton.disabled = isLoading;
      if (copyButton) copyButton.disabled = isLoading;
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearError();
      resultEl?.classList.add("hidden");

      const url = urlInput?.value.trim() ?? "";

      if (!url) {
        setError("Please enter a URL to shorten.");
        urlInput?.focus();
        return;
      }

      setLoading(true);

      try {
        const result = await createShortUrl(url);
        shortUrl = result.shortUrl;
        if (resultLink) {
          resultLink.href = shortUrl;
          resultLink.textContent = shortUrl;
        }
        resultEl?.classList.remove("hidden");
      } catch (err) {
        const message = err instanceof Error ? err.message : "Something went wrong. Please try again.";
        setError(message);
      } finally {
        setLoading(false);
      }
    });

    copyButton?.addEventListener("click", async () => {
      if (!shortUrl) return;
      try {
        await navigator.clipboard.writeText(shortUrl);
        copyButton.setAttribute("aria-label", "Copied!");
        copyButton.title = "Copied!";
        setTimeout(() => {
          copyButton.setAttribute("aria-label", "Copy short URL");
          copyButton.title = "Copy short URL";
        }, 2000);
      } catch {
        setError("Could not copy to clipboard. Please copy it manually.");
      }
    });
  </script>
</div>
