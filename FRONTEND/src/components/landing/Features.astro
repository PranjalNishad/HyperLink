---
const features = [
  {
    title: "Lightning Fast",
    description:
      "Create a short link in one request — no page reloads, no waiting around.",
    icon: '<path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z" />',
  },
  {
    title: "Detailed Analytics",
    description:
      "Track cumulative clicks per link and see which links perform best.",
    icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />',
  },
  {
    title: "Custom Links",
    description:
      "Choose a memorable slug instead of a random one, or let HyperLink generate it.",
    icon: '<path d="m9.5 14.5 5-5" /><path d="M8 12.5 5.5 15a3 3 0 0 0 4.2 4.2L12 16.7" /><path d="M16 11.5 18.5 9a3 3 0 0 0-4.2-4.2L12 7.3" />',
  },
  {
    title: "Secure & Private",
    description:
      "bcrypt-hashed passwords, HttpOnly cookie sessions, rate-limited endpoints and per-account link ownership.",
    icon: '<path d="M12 3 5 6v5.5c0 4.2 2.8 7.6 7 9.5 4.2-1.9 7-5.3 7-9.5V6l-7-3Z" /><path d="m9 11.5 2 2 4-4" />',
  },
];
---

<section id="features" class="relative scroll-mt-24">
  <div class="container-wide home-rails home-section px-4 sm:px-6 lg:px-10">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <span class="home-eyebrow">// Features</span>
        <h2 class="home-heading mt-3">
          Everything you need for <span class="text-[var(--color-primary)]">better links</span>
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">
          Simple tools for creating, managing and understanding every link you share.
        </p>
      </div>

      <a
        href="#how-it-works"
        class="group inline-flex items-center gap-2 self-start rounded-md border border-[var(--color-border)] bg-[var(--frame-fill)] px-4 py-2 text-[13px] font-medium text-[var(--color-text-secondary)] backdrop-blur-sm transition-colors hover:border-[var(--color-border-hover)] hover:text-[var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-background)] md:self-auto"
      >
        See how it works
        <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

    <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature, index) => (
          <article
            class="home-reveal frame-card group transition-colors hover:border-[var(--color-border-hover)]"
            style={`--reveal-i: ${index}`}
          >
            <div class="frame-card-inner flex flex-col gap-4">
              <span class="text-[var(--color-text-subtle)] transition-colors group-hover:text-[var(--color-primary)]">
                <svg
                  viewBox="0 0 24 24"
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={feature.icon}
                />
              </span>

              <div>
                <h3 class="m-0 text-sm font-medium tracking-tight text-[var(--color-text-primary)]">
                  {feature.title}
                </h3>
                <p class="mt-1.5 m-0 text-[13px] leading-relaxed text-[var(--color-text-muted)]">
                  {feature.description}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
