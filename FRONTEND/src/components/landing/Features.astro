---
const features = [
  {
    title: "URL Shortening",
    description: "Convert long URLs into short, clean links that are easy to share.",
    icon: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.72" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.72-1.72" />',
  },
  {
    title: "Custom URLs",
    description: "Create branded or custom short links with your own memorable slugs.",
    icon: '<path d="m9.5 14.5 5-5" /><path d="M8 12.5 5.5 15a3 3 0 0 0 4.2 4.2L12 16.7" /><path d="M16 11.5 18.5 9a3 3 0 0 0-4.2-4.2L12 7.3" />',
  },
  {
    id: "analytics",
    title: "Analytics",
    description: "Track total clicks and link performance with cumulative analytics.",
    icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />',
  },
  {
    title: "Redirects",
    description: "Fast and secure redirection from short links to destination URLs.",
    icon: '<path d="M5 12h14M13 6l6 6-6 6" />',
  },
  {
    title: "User Sign In / Sign Up",
    description: "Save and manage your links with a personal HyperLink account.",
    icon: '<circle cx="12" cy="8" r="4" /><path d="M5 20c1.5-3 4-4.5 7-4.5s5.5 1.5 7 4.5" />',
  },
  {
    title: "Beautiful & Simple UI",
    description: "Clean, modern, and minimal design focused on what matters.",
    icon: '<path d="M12 2 2 7l10 5 10-5-10-5Z" /><path d="m2 17 10 5 10-5" /><path d="M2 12 12 17l10-5" />',
  },
];
---

<section class="container-page py-20 md:py-28" id="features">
  <div class="mx-auto max-w-2xl text-center">
    <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-primary)]">Features</span>
    <h2 class="mt-3 m-0 text-3xl font-semibold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
      Everything you need for <span class="gradient-text">better links</span>
    </h2>
    <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-[var(--color-text-muted)]">
      Simple tools for creating, managing, and understanding every link you share.
    </p>
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <div
          id={feature.id}
          class:list={[
            "group rounded-2xl border border-[var(--glass-border)] bg-[var(--glass-panel)] p-5 backdrop-blur-xl transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--glass-border-hover)] hover:shadow-[var(--shadow-glow)]",
            feature.id && "scroll-mt-24",
          ]}
        >
          <div class="flex items-start gap-4">
            <div class="icon-gradient group-hover:shadow-[0_0_24px_rgba(255,138,101,0.18)]">
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={feature.icon}
              />
            </div>
            <div class="min-w-0">
              <h3 class="m-0 text-base font-semibold tracking-tight text-[var(--color-text-primary)]">
                {feature.title}
              </h3>
              <p class="mt-1 m-0 text-sm leading-relaxed text-[var(--color-text-muted)]">
                {feature.description}
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
