---
interface Props {
  /** Modal heading. */
  title?: string;
  /** Supporting text shown under the title. */
  description?: string;
  /** Opens the modal automatically once the page loads. */
  open?: boolean;
  /** Width preset. */
  size?: "sm" | "md" | "lg";
  /** Shows the top-right close button. */
  showClose?: boolean;
  /** Unique id — required to open this modal from a trigger. */
  id?: string;
  /** Extra classes merged onto the panel. */
  class?: string;
}

let modalSeq = 0;

const {
  title = "",
  description = "",
  open = false,
  size = "md",
  showClose = true,
  id = "",
  class: className = "",
} = Astro.props;

const dialogId = id || `nx-modal-${++modalSeq}`;
const hasTitle = title.length > 0;
const hasDescription = description.length > 0;
const titleId = hasTitle ? `${dialogId}-title` : undefined;
const descriptionId = hasDescription ? `${dialogId}-description` : undefined;
const hasHeader = hasTitle || hasDescription || showClose;
const hasFooter = Astro.slots.has("footer");

const sizeClasses: Record<string, string> = {
  sm: "w-[min(calc(100vw_-_2rem),28rem)]",
  md: "w-[min(calc(100vw_-_2rem),32rem)]",
  lg: "w-[min(calc(100vw_-_2rem),42rem)]",
};
---

<dialog
  id={dialogId}
  class:list={["nx-modal", sizeClasses[size]]}
  data-size={size}
  data-open-on-load={open ? "true" : undefined}
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <div class:list={["nx-modal-panel", className]}>
    {
      hasHeader && (
        <header class="flex shrink-0 items-start justify-between gap-4 px-6 pt-6 sm:px-8 sm:pt-7">
          {
            (hasTitle || hasDescription) && (
              <div class="min-w-0">
                {
                  hasTitle && (
                    <h2
                      id={titleId}
                      class="m-0 text-xl font-semibold tracking-tight text-[var(--color-text-primary)] sm:text-[1.375rem]"
                    >
                      {title}
                    </h2>
                  )
                }
                {
                  hasDescription && (
                    <p
                      id={descriptionId}
                      class="m-0 mt-2 text-[0.9375rem] leading-relaxed text-[var(--color-text-muted)]"
                    >
                      {description}
                    </p>
                  )
                }
              </div>
            )
          }
          {
            showClose && (
              <button
                type="button"
                data-modal-close
                aria-label="Close"
                class="ml-auto inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-[var(--color-text-muted)] transition-colors hover:bg-[var(--glass-background-hover)] hover:text-[var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="m6 6 8 8M14 6l-8 8" />
                </svg>
              </button>
            )
          }
        </header>
      )
    }

    <div class="min-h-0 flex-1 overflow-y-auto px-6 py-5 sm:px-8 sm:py-6">
      <slot />
    </div>

    {
      hasFooter && (
        <footer class="nx-modal-footer flex shrink-0 flex-wrap items-center justify-end gap-3 border-t border-[var(--color-border-soft)] px-6 py-4 sm:px-8 sm:py-5">
          <slot name="footer" />
        </footer>
      )
    }
  </div>
</dialog>

<style is:global>
  /* Dialog chrome that can't be expressed with utilities. */
  dialog.nx-modal {
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-primary);
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - 2rem);
  }

  dialog.nx-modal::backdrop {
    background: var(--modal-backdrop);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  dialog.nx-modal[open] {
    display: flex;
    flex-direction: column;
    animation: nx-modal-in 180ms ease-out;
  }

  dialog.nx-modal[open]::backdrop {
    animation: nx-backdrop-in 180ms ease-out;
  }

  dialog.nx-modal.nx-is-closing {
    pointer-events: none;
    animation: nx-modal-out 160ms ease-in forwards;
  }

  dialog.nx-modal.nx-is-closing::backdrop {
    animation: nx-backdrop-out 160ms ease-in forwards;
  }

  .nx-modal-panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-height: inherit;
    overflow: hidden;

    border-radius: 22px;
    border: 1px solid var(--modal-border);
    background: var(--modal-surface);
    box-shadow: var(--modal-shadow);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  /* Lock page scrolling while any modal is open. */
  body:has(dialog.nx-modal[open]) {
    overflow: hidden;
  }

  /* Stack and stretch the action buttons on very narrow screens. */
  @media (max-width: 640px) {
    .nx-modal-footer > * {
      flex: 1 1 auto;
    }
  }

  @keyframes nx-modal-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes nx-modal-out {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }

  @keyframes nx-backdrop-in {
    from {
      opacity: 0;
    }
  }

  @keyframes nx-backdrop-out {
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    dialog.nx-modal[open],
    dialog.nx-modal[open]::backdrop,
    dialog.nx-modal.nx-is-closing,
    dialog.nx-modal.nx-is-closing::backdrop {
      animation: none;
    }
  }
</style>

<script>
  (function () {
    const win = window as Window & { __nxModalBound?: boolean };
    if (win.__nxModalBound) return;
    win.__nxModalBound = true;

    const DIALOG_SELECTOR = "dialog.nx-modal";

    function openDialog(dialog: HTMLDialogElement | null) {
      if (dialog && !dialog.open) dialog.showModal();
    }

    function closeDialog(dialog: HTMLDialogElement | null) {
      if (!dialog || !dialog.open || dialog.classList.contains("nx-is-closing")) return;
      dialog.classList.add("nx-is-closing");
      window.setTimeout(function () {
        dialog.classList.remove("nx-is-closing");
        dialog.close();
      }, 200);
    }

    document.querySelectorAll(DIALOG_SELECTOR + "[data-open-on-load]").forEach(function (el) {
      const dialog = el as HTMLDialogElement;
      if (dialog.dataset.openOnLoad === "true") openDialog(dialog);
    });

    // Intercept Escape so the close animation can play before closing.
    document.addEventListener(
      "cancel",
      function (event) {
        const dialog = event.target;
        if (dialog instanceof HTMLDialogElement && dialog.matches(DIALOG_SELECTOR)) {
          event.preventDefault();
          closeDialog(dialog);
        }
      },
      true
    );

    document.addEventListener("click", function (event) {
      const target = event.target;
      if (!(target instanceof Element)) return;

      // Trigger button: <button data-modal-open="modal-id">.
      const trigger = target.closest("[data-modal-open]");
      if (trigger) {
        const id = trigger.getAttribute("data-modal-open");
        const dialog = id ? document.getElementById(id) : null;
        if (dialog instanceof HTMLDialogElement) {
          event.preventDefault();
          openDialog(dialog);
        }
        return;
      }

      // Close button / custom close control.
      const closeButton = target.closest("[data-modal-close]");
      if (closeButton) {
        closeDialog(closeButton.closest(DIALOG_SELECTOR));
        return;
      }

      // Backdrop click — the target is the dialog element itself.
      if (target instanceof HTMLDialogElement && target.matches(DIALOG_SELECTOR)) {
        closeDialog(target);
      }
    });
  })();
</script>
