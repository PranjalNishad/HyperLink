---
interface Props {
  /** Visible label above the input. */
  label?: string;
  /** Placeholder text inside the input. */
  placeholder?: string;
  /** Controlled or initial value. */
  value?: string;
  /** Form field name. */
  name?: string;
  /** Element id; also used to associate the label and messages. */
  id?: string;
  /** Native input type. Defaults to "text". */
  type?: "text" | "url" | "email" | "password" | "number" | "search" | "tel";
  /** Marks the field as required. */
  required?: boolean;
  /** Disables the input. */
  disabled?: boolean;
  /** Makes the field read-only. */
  readonly?: boolean;
  /** Error message; renders in red below and sets aria-invalid. */
  error?: string;
  /** Helper text shown below the input when there is no error. */
  helper?: string;
  /** Optional autoComplete value passed to the native input. */
  autocomplete?: string;
  /** Extra classes merged onto the input element. */
  class?: string;
  /** Renders a show/hide toggle for password fields. */
  togglePassword?: boolean;
  /** Optional icon/label rendered inside the left side of the field. */
  [key: string]: unknown;
}

const {
  label = "",
  placeholder = "",
  value = "",
  name = "",
  id = "",
  type = "text",
  required = false,
  disabled = false,
  readonly = false,
  error = "",
  helper = "",
  autocomplete = "",
  class: className = "",
  togglePassword = false,
  ...attrs
} = Astro.props;

// Only render when an error exists; keeps DOM clean otherwise.
const hasError = error.length > 0;

// Only include the message id when there is actually a message.
const describedBy = hasError
  ? `${id}-error`
  : helper.length > 0
    ? `${id}-helper`
    : undefined;

// True when the caller passes an <span slot="icon">…</span>.
const hasIcon = Astro.slots.has("icon");

// Password fields can opt into a show/hide toggle.
const hasPasswordToggle = type === "password" && togglePassword;

const inputClasses = [
  // Base input styling from the design system.
  "input-base",
  // Spacing / sizing / typography.
  "w-full",
  "h-11",
  "text-sm",
  "text-[var(--color-text-primary)]",
  "placeholder:text-[var(--color-text-subtle)]",
  // Leave room for the leading icon and/or trailing password toggle when provided.
  hasIcon ? "pl-10" : "pl-4",
  hasPasswordToggle ? "pr-11" : "pr-4",
  // Error overrides.
  hasError ? "input-error" : "",
  // Custom classes passed by the caller.
  className,
].join(" ");
---

<div class="w-full">
  {
    label && (
      <label
        for={id}
        class:list={[
          "mb-2",
          "block",
          "text-sm",
          "font-medium",
          "text-[var(--color-text-primary)]",
          disabled && "opacity-50",
        ]}
      >
        {label}
        {required && <span class="text-[var(--color-primary)]"> *</span>}
      </label>
    )
  }

  <div class="relative">
    {
      hasIcon && (
        <div
          class:list={[
            "pointer-events-none",
            "absolute",
            "inset-y-0",
            "left-3.5",
            "z-10",
            "flex",
            "items-center",
            "text-[var(--color-text-muted)]",
            hasError && "text-[var(--color-danger)]",
          ]}
          aria-hidden="true"
        >
          <slot name="icon" />
        </div>
      )
    }

    <input
      type={type}
      id={id || undefined}
      name={name || undefined}
      value={value || undefined}
      placeholder={placeholder || undefined}
      required={required || undefined}
      disabled={disabled || undefined}
      readonly={readonly || undefined}
      autocomplete={autocomplete || undefined}
      aria-invalid={hasError || undefined}
      aria-describedby={describedBy}
      class:list={inputClasses.split(" ")}
    />

    {
      hasPasswordToggle && (
        <button
          type="button"
          data-password-toggle={id}
          aria-label="Show password"
          title="Show password"
          aria-pressed="false"
          class="absolute inset-y-0 right-0 z-10 flex w-11 items-center justify-center rounded-r-lg text-[var(--color-text-muted)] transition-colors duration-200 hover:text-[var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-password-icon="show">
            <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
          <svg viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-password-icon="hide">
            <path d="M3 3l18 18" />
            <path d="M10.6 10.6a3 3 0 0 0 4.2 4.2" />
            <path d="M9.9 5.7A9.6 9.6 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-3.2 4" />
            <path d="M6.1 6.6A17 17 0 0 0 2.5 12S6 18.5 12 18.5a9.7 9.7 0 0 0 4-.8" />
          </svg>
        </button>
      )
    }
  </div>

  {
    // Helper or error message below the field.
    (helper || hasError) && (
      <p
        id={describedBy}
        class:list={[
          "mt-2",
          "text-xs",
          "leading-relaxed",
          hasError
            ? "text-[var(--color-danger)]"
            : "text-[var(--color-text-muted)]",
        ]}
      >
        {hasError ? error : helper}
      </p>
    )
  }
</div>

<style>
  .input-base:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .input-base[readonly] {
    opacity: 0.7;
    cursor: default;
  }

  .input-error {
    border-color: rgba(248, 113, 113, 0.5);
  }

  .input-error:hover {
    border-color: rgba(248, 113, 113, 0.7);
  }

  .input-error:focus {
    border-color: var(--color-danger);
    box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.08);
  }
</style>
