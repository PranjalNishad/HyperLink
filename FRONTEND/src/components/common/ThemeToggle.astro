---
interface Props {
  /** Optional extra classes. */
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    "theme-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--glass-border)] bg-[var(--glass-background)] text-[var(--color-text-secondary)] backdrop-blur-md transition-colors duration-200 hover:bg-[var(--glass-background-hover)] hover:text-[var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]",
    className,
  ]}
  aria-label="Switch to light mode"
  title="Switch theme"
>
  <!-- Sun (shown in dark mode → switch to light) -->
  <svg class="theme-icon-sun h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <!-- Moon (shown in light mode → switch to dark) -->
  <svg class="theme-icon-moon hidden h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
</button>

<style is:global>
  :root[data-theme="dark"] .theme-icon-sun {
    display: block;
  }
  :root[data-theme="dark"] .theme-icon-moon {
    display: none;
  }
  :root[data-theme="light"] .theme-icon-sun {
    display: none;
  }
  :root[data-theme="light"] .theme-icon-moon {
    display: block;
  }
</style>

<script>
  const STORAGE_KEY = "hyperlink-theme";

  function currentTheme(): "light" | "dark" {
    return document.documentElement.getAttribute("data-theme") === "light"
      ? "light"
      : "dark";
  }

  function reflect(buttons: NodeListOf<HTMLButtonElement>) {
    const theme = currentTheme();
    const next = theme === "dark" ? "light" : "dark";
    buttons.forEach((btn) => {
      btn.setAttribute("aria-label", `Switch to ${next} mode`);
      btn.setAttribute("title", `Switch to ${next} mode`);
      btn.setAttribute("aria-pressed", theme === "light" ? "true" : "false");
    });
  }

  function init() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
    if (buttons.length === 0) return;

    reflect(buttons);

    buttons.forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const next = currentTheme() === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch {
          /* ignore storage errors */
        }
        reflect(buttons);
      });
    });
  }

  init();
</script>
