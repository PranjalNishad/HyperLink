---
import Button from "@/components/common/Button.astro";
import Input from "@/components/common/Input.astro";
---

<div class="w-full max-w-md">
  <!-- Wordmark -->
  <a href="/" class="inline-flex items-center gap-2 text-[var(--color-text-primary)]" aria-label="HyperLink home">
    <span
      class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--gradient-primary)] text-sm font-bold text-[#0b0b10]"
      aria-hidden="true"
    >
      N
    </span>
    <span class="text-lg font-semibold tracking-tight">
      <span class="font-light">Hyper</span>
      <span class="gradient-text font-semibold">Link</span>
    </span>
  </a>

  <!-- Heading -->
  <h1 class="mt-6 m-0 text-2xl font-semibold tracking-tight text-[var(--color-text-primary)]">
    Create your account
  </h1>
  <p class="mt-2 m-0 text-sm leading-relaxed text-[var(--color-text-muted)]">
    Start creating and managing short links with HyperLink.
  </p>

  <!-- Form -->
  <form id="signup-form" class="mt-8 flex flex-col gap-5" novalidate>
    <Input
      type="text"
      label="Name"
      name="name"
      id="signup-name"
      placeholder="Ada Lovelace"
      autocomplete="name"
      required
    />

    <Input
      type="email"
      label="Email"
      name="email"
      id="signup-email"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />

    <Input
      type="password"
      label="Password"
      name="password"
      id="signup-password"
      placeholder="Create a password"
      autocomplete="new-password"
      required
      togglePassword
    />

    <Input
      type="password"
      label="Confirm Password"
      name="confirmPassword"
      id="signup-confirm"
      placeholder="Repeat your password"
      autocomplete="new-password"
      required
      togglePassword
    />

    <p
      id="signup-match-error"
      class="m-0 hidden text-sm text-[var(--color-danger)]"
      role="alert"
    >
      Passwords do not match.
    </p>

    <Button type="submit" fullWidth size="lg" class="mt-1" id="signup-submit">
      Create Account
    </Button>

    <p
      id="signup-error"
      class="m-0 hidden text-center text-sm text-[var(--color-danger)]"
      role="alert"
    ></p>
  </form>

  <!-- Footer -->
  <div class="mt-8 border-t border-[var(--color-border-soft)] pt-6 text-center">
    <p class="m-0 text-sm text-[var(--color-text-muted)]">
      Already have an account?&nbsp;
      <a
        href="/login"
        class="font-medium text-[var(--color-text-primary)] transition-colors duration-200 hover:text-[var(--color-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]"
      >
        Sign in
      </a>
    </p>
  </div>
</div>

<script>
  import { register } from "@/api/auth.api";
  import { initPasswordToggles } from "@/utils/passwordToggle";

  initPasswordToggles();

  const form = document.getElementById("signup-form") as HTMLFormElement | null;
  const nameInput = document.getElementById("signup-name") as HTMLInputElement | null;
  const emailInput = document.getElementById("signup-email") as HTMLInputElement | null;
  const passwordInput = document.getElementById("signup-password") as HTMLInputElement | null;
  const confirmInput = document.getElementById("signup-confirm") as HTMLInputElement | null;
  const submitButton = document.getElementById("signup-submit") as HTMLButtonElement | null;
  const errorEl = document.getElementById("signup-error") as HTMLParagraphElement | null;
  const matchError = document.getElementById("signup-match-error");

  const SUBMIT_LABEL = "Create Account";
  let isSubmitting = false;

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.textContent = "";
    errorEl.classList.add("hidden");
  }

  function setLoading(isLoading: boolean) {
    isSubmitting = isLoading;
    if (!submitButton) return;
    submitButton.disabled = isLoading;
    submitButton.textContent = isLoading ? "Creating account…" : SUBMIT_LABEL;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (isSubmitting) return;

    clearError();

    const name = nameInput?.value.trim() ?? "";
    const email = emailInput?.value.trim() ?? "";
    const password = passwordInput?.value ?? "";
    const confirmPassword = confirmInput?.value ?? "";

    if (!name || !email || !password) {
      showError("Please fill in all fields.");
      return;
    }

    if (password !== confirmPassword) {
      matchError?.classList.remove("hidden");
      confirmInput?.focus();
      return;
    }
    matchError?.classList.add("hidden");

    setLoading(true);

    try {
      await register(name, email, password);
      window.location.href = "/dashboard";
    } catch (err) {
      showError(
        err instanceof Error
          ? err.message
          : "Could not create your account. Please try again.",
      );
      setLoading(false);
    }
  });

  // Clear the mismatch error as the user types.
  confirmInput?.addEventListener("input", () => {
    matchError?.classList.add("hidden");
  });
</script>
