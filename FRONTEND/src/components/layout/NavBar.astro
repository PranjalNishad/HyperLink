---
import ThemeToggle from "@/components/common/ThemeToggle.astro";

const links = [
  { href: "#features", label: "Features" },
  { href: "#analytics", label: "Analytics" },
  { href: "#how-it-works", label: "How it works" },
];
---

<header class="relative z-50">
  <nav class="container-wide flex h-12 items-center justify-between px-5 sm:px-8 lg:px-12" aria-label="Main">
    <!-- Brand -->
    <a href="/" class="flex shrink-0 items-center gap-2 text-[var(--color-text-primary)]" aria-label="HyperLink home">
      <span
        class="flex h-7 w-7 items-center justify-center rounded-md bg-[image:var(--gradient-primary)] text-[13px] font-bold text-[var(--btn-text)]"
        aria-hidden="true"
      >
        H
      </span>
      <span class="text-[15px] font-medium tracking-tight">
        <span class="font-light">Hyper</span>
        <span class="font-semibold text-[var(--color-primary)]">Link</span>
      </span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-1 font-mono text-xs text-[var(--color-text-muted)] lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded px-2.5 py-1.5 transition-colors hover:bg-[var(--primary-wash)] hover:text-[var(--color-primary)] focus-brand"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Desktop actions -->
    <div class="hidden items-center gap-3 lg:flex">
      <ThemeToggle />

      <a
        href="/login"
        data-guest-only
        class="inline-flex items-center gap-1.5 rounded-md border border-[var(--color-border)] px-3.5 py-1.5 text-[12px] font-medium text-[var(--color-text-secondary)] transition-colors hover:border-[var(--color-border-hover)] hover:text-[var(--color-text-primary)] focus-brand"
      >
        Sign in
      </a>
      <a
        href="/signup"
        data-guest-only
        class="inline-flex items-center gap-1.5 rounded-md bg-[image:var(--gradient-primary)] px-3.5 py-1.5 text-[12px] font-medium text-[var(--btn-text)] transition hover:brightness-105 focus-brand"
      >
        Get Started
      </a>
      <a
        href="/dashboard"
        data-auth-only
        style="display:none"
        class="inline-flex items-center gap-1.5 rounded-md bg-[image:var(--gradient-primary)] px-3.5 py-1.5 text-[12px] font-medium text-[var(--btn-text)] transition hover:brightness-105 focus-brand"
      >
        Dashboard
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
      class="relative z-[70] flex size-9 flex-col items-center justify-center gap-[5px] lg:hidden"
    >
      <span class="block h-[1.5px] w-5 rounded-full bg-[var(--color-text-primary)]" data-nav-icon-open />
      <span class="block h-[1.5px] w-5 rounded-full bg-[var(--color-text-primary)]" data-nav-icon-open />
      <span class="block h-[1.5px] w-5 rounded-full bg-[var(--color-text-primary)]" data-nav-icon-open />
      <span class="absolute h-[1.5px] w-5 rotate-45 rounded-full bg-[var(--color-text-primary)] hidden" data-nav-icon-close />
      <span class="absolute h-[1.5px] w-5 -rotate-45 rounded-full bg-[var(--color-text-primary)] hidden" data-nav-icon-close />
    </button>
  </nav>

  <!-- Full-screen mobile menu -->
  <div
    id="mobile-menu"
    data-nav-menu
    class="fixed inset-0 z-[60] hidden flex-col bg-[var(--color-background)] lg:hidden"
  >
    <div class="container-wide flex h-full min-h-0 flex-col px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] sm:px-8">
      <div class="flex h-12 shrink-0 items-center justify-between">
        <a href="/" class="flex items-center gap-2" aria-label="HyperLink home">
          <span
            class="flex h-7 w-7 items-center justify-center rounded-md bg-[image:var(--gradient-primary)] text-[13px] font-bold text-[var(--btn-text)]"
            aria-hidden="true"
          >
            H
          </span>
          <span class="text-[15px] font-medium tracking-tight text-[var(--color-text-primary)]">
            <span class="font-light">Hyper</span>
            <span class="font-semibold text-[var(--color-primary)]">Link</span>
          </span>
        </a>
        <button
          type="button"
          data-nav-close
          aria-label="Close menu"
          class="flex size-9 items-center justify-center"
        >
          <span class="relative block size-5">
            <span class="absolute top-1/2 left-0 h-[1.5px] w-5 rotate-45 rounded-full bg-[var(--color-text-primary)]"></span>
            <span class="absolute top-1/2 left-0 h-[1.5px] w-5 -rotate-45 rounded-full bg-[var(--color-text-primary)]"></span>
          </span>
        </button>
      </div>

      <nav class="min-h-0 flex-1 overflow-y-auto overscroll-contain py-5" aria-label="Mobile">
        <ul class="m-0 flex list-none flex-col gap-0.5 p-0">
          {
            links.map((link, index) => (
              <li class="nav-mobile-item" style={`--nav-i: ${index}`}>
                <a
                  href={link.href}
                  class="block py-1.5 font-mono text-[1.65rem] leading-tight font-bold tracking-tight text-[var(--color-text-secondary)] uppercase transition-colors hover:text-[var(--color-primary)] focus-brand sm:text-4xl"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="nav-mobile-item flex shrink-0 flex-col gap-2.5 border-t border-[var(--color-border)] pt-4" style="--nav-i: 3">
        <div class="flex w-full items-center justify-between rounded-xl border border-[var(--color-border)] px-4 py-3">
          <span class="font-mono text-sm font-bold text-[var(--color-text-muted)] uppercase">
            Theme
          </span>
          <ThemeToggle />
        </div>

        <a
          href="/login"
          data-guest-only
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[var(--color-border)] py-3.5 font-mono text-base font-bold text-[var(--color-text-secondary)] uppercase transition-colors hover:border-[var(--color-border-hover)] hover:text-[var(--color-text-primary)] focus-brand"
        >
          Sign in
        </a>
        <a
          href="/signup"
          data-guest-only
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-[image:var(--gradient-primary)] py-3.5 font-mono text-base font-bold text-[var(--btn-text)] uppercase transition hover:brightness-105 focus-brand"
        >
          Get Started
        </a>
        <a
          href="/dashboard"
          data-auth-only
          style="display:none"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-[image:var(--gradient-primary)] py-3.5 font-mono text-base font-bold text-[var(--btn-text)] uppercase transition hover:brightness-105 focus-brand"
        >
          Dashboard
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { initAuthState } from "@/utils/authState";

  initAuthState();

  const menu = document.querySelector<HTMLElement>("[data-nav-menu]");
  const toggles = document.querySelectorAll<HTMLElement>("[data-nav-toggle], [data-nav-close]");
  const iconsOpen = document.querySelectorAll<HTMLElement>("[data-nav-icon-open]");
  const iconsClose = document.querySelectorAll<HTMLElement>("[data-nav-icon-close]");
  let previousOverflow = "";

  function isOpen() {
    return !!menu && !menu.classList.contains("hidden");
  }

  function setIcons(open: boolean) {
    iconsOpen.forEach((icon) => icon.classList.toggle("hidden", open));
    iconsClose.forEach((icon) => icon.classList.toggle("hidden", !open));
  }

  function openMenu() {
    if (!menu) return;
    menu.classList.remove("hidden");
    menu.classList.add("flex");
    toggles.forEach((toggle) => toggle.setAttribute("aria-expanded", "true"));
    setIcons(true);
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    if (!menu) return;
    menu.classList.add("hidden");
    menu.classList.remove("flex");
    toggles.forEach((toggle) => toggle.setAttribute("aria-expanded", "false"));
    setIcons(false);
    document.body.style.overflow = previousOverflow;
  }

  toggles.forEach((toggle) => {
    toggle.addEventListener("click", () => (isOpen() ? closeMenu() : openMenu()));
  });

  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) closeMenu();
  });
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches && isOpen()) closeMenu();
  });
</script>
