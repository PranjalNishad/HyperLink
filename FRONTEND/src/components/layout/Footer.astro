---
const productLinks = [
  { href: "#features", label: "Features" },
  { href: "#analytics", label: "Analytics" },
  { href: "#how-it-works", label: "How it works" },
];
---

<footer class="relative">
  <div class="container-wide home-rails home-section px-4 sm:px-6 lg:px-10">
    <div class="home-rule"></div>

    <div class="grid gap-10 py-10 md:py-12 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-10">
      <!-- Brand -->
      <div class="max-w-sm">
        <a href="/" class="flex items-center gap-2 text-[var(--color-text-primary)]" aria-label="HyperLink home">
          <span
            class="flex h-7 w-7 items-center justify-center rounded-md bg-[image:var(--gradient-primary)] text-[13px] font-bold text-[var(--btn-text)] glow-soft"
            aria-hidden="true"
          >
            H
          </span>
          <span class="text-[15px] font-medium tracking-tight">
            <span class="font-light">Hyper</span>
            <span class="font-semibold text-[var(--color-primary)]">Link</span>
          </span>
        </a>
        <p class="mt-3 text-[13px] leading-relaxed text-[var(--color-text-muted)]">
          Short links with cumulative click analytics, custom slugs and a dashboard
          for every link you share.
        </p>
      </div>

      <!-- Link columns -->
      <div class="grid grid-cols-2 gap-8 sm:gap-12 lg:border-l lg:border-[var(--color-border)] lg:pl-10">
        <nav aria-label="Product">
          <h2 class="m-0 font-mono text-[10px] tracking-[0.18em] text-[var(--color-text-subtle)] uppercase">
            // Product
          </h2>
          <ul class="mt-4 flex list-none flex-col gap-2.5 p-0">
            {
              productLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[13px] text-[var(--color-text-muted)] underline decoration-transparent underline-offset-4 transition-colors hover:text-[var(--color-primary)] hover:decoration-[var(--color-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-label="Account">
          <h2 class="m-0 font-mono text-[10px] tracking-[0.18em] text-[var(--color-text-subtle)] uppercase">
            // Account
          </h2>
          <ul class="mt-4 flex list-none flex-col gap-2.5 p-0">
            <li data-guest-only>
              <a
                href="/login"
                class="text-[13px] text-[var(--color-text-muted)] underline decoration-transparent underline-offset-4 transition-colors hover:text-[var(--color-primary)] hover:decoration-[var(--color-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]"
              >
                Login
              </a>
            </li>
            <li data-guest-only>
              <a
                href="/signup"
                class="text-[13px] text-[var(--color-text-muted)] underline decoration-transparent underline-offset-4 transition-colors hover:text-[var(--color-primary)] hover:decoration-[var(--color-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]"
              >
                Sign up
              </a>
            </li>
            <li data-auth-only style="display:none">
              <a
                href="/dashboard"
                class="text-[13px] text-[var(--color-text-muted)] underline decoration-transparent underline-offset-4 transition-colors hover:text-[var(--color-primary)] hover:decoration-[var(--color-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]"
              >
                Dashboard
              </a>
            </li>
            <li data-auth-only style="display:none">
              <a
                href="/settings"
                class="text-[13px] text-[var(--color-text-muted)] underline decoration-transparent underline-offset-4 transition-colors hover:text-[var(--color-primary)] hover:decoration-[var(--color-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]"
              >
                Settings
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="home-rule"></div>

    <div class="flex flex-col items-start justify-between gap-3 py-6 sm:flex-row sm:items-center">
      <p class="m-0 font-mono text-[9px] tracking-[0.14em] text-[var(--color-text-subtle)] uppercase">
        © 2026 HyperLink. All rights reserved.
      </p>
      <p class="m-0 font-mono text-[9px] tracking-[0.14em] text-[var(--color-text-subtle)] uppercase">
        Built with Astro, Hono and MongoDB
      </p>
    </div>

    <!-- Oversized outline wordmark -->
    <div aria-hidden="true" class="pointer-events-none select-none overflow-hidden pb-6 text-center">
      <span
        class="block font-mono text-[clamp(3.25rem,12.5vw,11.5rem)] font-bold leading-none tracking-[-0.05em] text-transparent"
        style="-webkit-text-stroke: 1px var(--home-rail);"
      >HYPERLINK</span>
    </div>
  </div>
</footer>
