---
import "../styles/global.css";
import CosmicBackground from "@/components/cosmic/CosmicBackground.astro";

interface Props {
  title?: string;
  description?: string;
  /** Decorative star count for the cosmic backdrop. */
  stars?: number;
}

const {
  title = "HyperLink — Short Links. Big Possibilities.",
  description = "Create short, powerful links with HyperLink.",
  stars = 18,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#080a12" />

    <title>{title}</title>

    <!-- Apply the saved/system theme before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("hyperlink-theme");
          var theme =
            saved === "light" || saved === "dark"
              ? saved
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--color-background)] text-[var(--color-foreground)]">
    <CosmicBackground stars={stars} />
    <slot />
  </body>
</html>
